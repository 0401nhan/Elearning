DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=your_mysql_user
DATABASE_PASSWORD=your_mysql_password
DATABASE_NAME=eb_elearning
DATABASE_CONNECTION_LIMIT=20
SESSION_SECRET=replace_with_a_long_random_secret
# Creates schema and seed data only when DATABASE_NAME does not exist.
# If the database already exists, startup will not seed it.
AUTO_DB_INIT=true
AUTO_DB_MIGRATE=true
PORT=6000
ASSIGN_ADMIN_ONBOARDING_TEST=true

# Optional. If set, this takes priority over the fields above.
DATABASE_URL=mysql://your_mysql_user:your_mysql_password@127.0.0.1:3306/eb_elearning
